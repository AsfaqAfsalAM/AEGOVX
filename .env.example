# Website Security Checker Environment Variables

# VirusTotal API v3 Key (Free tier: 4 req/min, 500 req/day)
# Get your free key at: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# Google Safe Browsing API v4 Key (Optional direct feed)
# Get your free key from Google Cloud Console
GOOGLE_SAFE_BROWSING_KEY=

# Database URL (Optional SQLite path or PostgreSQL connection string)
# Defaults to local SQLite db: ./data/scanner.db
DATABASE_URL=file:./data/scanner.db

# Rate Limiting & Queue Settings
RATE_LIMIT_PER_MINUTE=5
CACHE_TTL_HOURS=1
SCAN_TIMEOUT_SECONDS=15

# App Base URL (for public API / badge generation / report sharing)
NEXT_PUBLIC_APP_URL=http://localhost:3000
